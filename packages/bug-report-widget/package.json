{
  "name": "thread-catch",
  "version": "1.1.1",
  "description": "A plug-and-play bug-report widget that creates tagged Discord Forum posts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "node": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "thread-catch": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "server-only": "^0.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/ws": "^8.5.13",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "discord",
    "bug-report",
    "nextjs",
    "react",
    "widget"
  ]
}
